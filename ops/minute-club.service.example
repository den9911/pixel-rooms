[Unit]
Description=Minute Club application
After=network.target

[Service]
Type=simple
User=minute
Group=minute
WorkingDirectory=/srv/minute-club
EnvironmentFile=/etc/minute-club.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/minute-club/data
UMask=0077

[Install]
WantedBy=multi-user.target
